rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    function isInstructor() {
      return signedIn() && (userDoc().role == 'instructor' || userDoc().role == 'admin');
    }

    function isEnrolled(courseId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/classroomCourses/$(courseId)).data.enrolledStudentIds;
    }

    function isCourseInstructor(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/classroomCourses/$(courseId)).data.instructorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
    }

    // AI classroom slides — generated once per lesson, then read from cache
    match /lessonClassroomSlides/{slideId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /courseContent/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        || (isInstructor() && isCourseInstructor(courseId));
    }

    match /classroomCourses/{courseId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isInstructor() || isAdmin());
      allow update: if isCourseInstructor(courseId) || isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudentIds', 'updatedAt']));
      allow delete: if isAdmin();

      match /posts/{postId} {
        allow read: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
        allow create: if isCourseInstructor(courseId) || isAdmin();
        allow update, delete: if isCourseInstructor(courseId) || isAdmin();

        match /comments/{commentId} {
          allow read: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
          allow create: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
        }
      }

      match /assignments/{assignmentId} {
        allow read: if isEnrolled(courseId) || isCourseInstructor(courseId) || isAdmin();
        allow create, update, delete: if isCourseInstructor(courseId) || isAdmin();

        match /submissions/{submissionId} {
          allow read: if isCourseInstructor(courseId) || isAdmin()
            || (signedIn() && resource.data.studentId == request.auth.uid);
          allow create: if signedIn()
            && request.resource.data.studentId == request.auth.uid
            && isEnrolled(courseId);
          allow update: if isCourseInstructor(courseId) || isAdmin()
            || (signedIn()
              && resource.data.studentId == request.auth.uid
              && isEnrolled(courseId));
        }
      }
    }

    match /quizAttempts/{attemptId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /courseBundles/{bundleId} {
      allow read: if signedIn();
      allow create: if isInstructor()
        && request.resource.data.instructorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.instructorId == request.auth.uid;
    }

    function isStartupIdeaOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isStartupIdeaOwnerOnCreate() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function founderCannotEscalateIdeaStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || request.resource.data.status in ['draft', 'submitted'];
    }

    match /startupIdeas/{ideaId} {
      allow read: if signedIn() && (isStartupIdeaOwner() || isAdmin());
      allow create: if isStartupIdeaOwnerOnCreate();
      allow update: if isAdmin()
        || (isStartupIdeaOwner() && founderCannotEscalateIdeaStatus());
      allow delete: if isAdmin() || isStartupIdeaOwner();
    }

    function isPitchOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function founderCannotEscalatePitchStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewerNotes'])
        || (request.resource.data.status in ['draft', 'submitted']
          && request.resource.data.reviewerNotes == resource.data.reviewerNotes);
    }

    match /startupPitchDecks/{deckId} {
      allow read: if signedIn() && (isPitchOwner() || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (isPitchOwner() && founderCannotEscalatePitchStatus());
      allow delete: if isAdmin() || isPitchOwner();
    }

    match /mentorshipSlots/{slotId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mentorshipBookings/{bookingId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'topic']));
      allow delete: if isAdmin();
    }
  }
}
